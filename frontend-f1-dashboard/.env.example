# Next.js Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# Backend API URL
NEXT_PUBLIC_API_URL=https://formula1-backend-latest.onrender.com

# Next.js Server Actions encryption key (optional — set for stable cross-deployment
# encryption instead of relying on a build-time-generated key).
# Generate a secure random 32-byte key, e.g.:
#   openssl rand -base64 32
# Do NOT commit the actual key; keep it only in .env.local or your secrets manager.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
